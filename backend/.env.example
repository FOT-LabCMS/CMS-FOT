# Server Configuration
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173

# Persistent File Storage Directory
# Local development default: ./uploads (or leave empty to default to backend/uploads)
# Campus production example: /var/lib/cms-fot/uploads
UPLOADS_DIR=./uploads

# Database Configuration (Example for PostgreSQL)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=flcms_db
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_for_development

# Initial Admin User Credentials (for seeding)
ADMIN_INSTITUTIONAL_ID=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_FULL_NAME=

#Mail Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=your-email@fot.ruh.ac.lk
SMTP_PASSWORD=your-password

MAIL_FROM_NAME=FOTLAB
MAIL_FROM_ADDRESS=your-email@fot.ruh.ac.lk